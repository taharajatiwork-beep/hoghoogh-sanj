# کپی کن به .env و مقدارها را پر کن. فایل .env را جایی منتشر نکن.
PORT=8765
BASE_URL=https://your-domain.example      # آدرس عمومی سایت (برای لینک‌ها و پیش‌نمایش اشتراک)
TRUST_PROXY=0                             # پشت nginx/Cloudflare بودی: 1

# دکمه‌های «دنبال کن»؛ خالی بگذاری، دکمه‌اش نمایش داده نمی‌شود
X_HANDLE=                                 # حساب ایکس، بدون @
TG_BOT=                                   # نام کاربری ربات تلگرام، بدون @
TG_CHANNEL=                               # نام کاربری کانال تلگرام، بدون @

# ربات تلگرام (از @BotFather). خالی = ربات اجرا نمی‌شود
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=                      # مثلا @mychannel؛ ربات باید ادمین کانال باشد

# پست هفتگی در ایکس (کلیدهای developer.x.com با دسترسی نوشتن). خالی = فقط پیش‌نمایش
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# توکن دسترسی به آمار مدیریتی: /api/admin/stats?token=...  (خالی = غیرفعال)
ADMIN_TOKEN=
